{
  "name": "remedacarehms",
  "private": true,
  "version": "1.1.0",
  "description": "RemedacareHMS Hospital Management System",
  "author": "RemedacareHMS",
  "homepage": "https://remedacarehms.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaizen2030/remedacarehms.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:smoke": "vitest run src/app.smoke.test.jsx",
    "test:db": "npm --prefix supabase/tests/db test",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "node electron/start-dev.js",
    "electron:build": "vite build && electron-builder",
    "test:e2e": "playwright test",
    "test:e2e:live": "npx playwright test e2e/live-app.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lab-bridge": "node tools/lab-bridge/bridge.mjs"
  },
  "build": {
    "appId": "com.remedacarehms.app",
    "productName": "RemedacareHMS",
    "protocols": [
      {
        "name": "RemedacareHMS",
        "schemes": [
          "remedacarehms"
        ]
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "icon.ico",
      "license.txt"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "license": "license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RemedacareHMS",
      "runAfterFinish": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@supabase/supabase-js": "^2.39.0",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^3.11.122",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.8.1",
    "serialport": "^13.0.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.0.3",
    "axe-core": "^4.10.2",
    "concurrently": "^8.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^4.4.5",
    "vitest": "^3.2.1",
    "wait-on": "^9.0.5"
  }
}
